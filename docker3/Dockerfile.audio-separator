# ============================================================
# Audio Separator — Voice/Music Separation Service
# Uses audio-separator with UVR models (MDX23C)
# ============================================================

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    onnxruntime-gpu \
    'audio-separator[gpu]' \
    fastapi \
    uvicorn \
    python-multipart

# Create directories
RUN mkdir -p /output /app

# Copy server code
COPY docker3/server_audio_separator.py /app/server.py

WORKDIR /app

# Environment
ENV MODEL_NAME=melband_roformer_big_beta4.ckpt
ENV OUTPUT_DIR=/output

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8300/health || exit 1

# Run server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8300"]
