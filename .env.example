# ============================================
# Dublaj — Video Dubbing Pipeline Configuration (.env TEMPLATE)
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# --- General ---
APP_HOST=0.0.0.0
APP_PORT=8000
TEMP_DIR=./tmp
OUTPUT_DIR=./output
DATABASE_URL=sqlite+aiosqlite:///./data/voicelabs.db
STORAGE_DIR=./data/storage

# --- Direct local models ---
WHISPER_MODEL_REPO=deepdml/faster-whisper-large-v3-turbo-ct2
OMNIVOICE_MODEL=k2-fsa/OmniVoice
# Optional: HF hub cache root. Empty = standard ~/.cache/huggingface/hub
MODEL_CACHE_DIR=
HF_TOKEN=
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- OmniVoice TTS ---
OMNIVOICE_VOICE=female
AI_DEVICE=auto

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
